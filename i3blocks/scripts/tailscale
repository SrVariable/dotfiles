#!/usr/bin/env bash
# Tailscale state; left click toggles up/down (requires `tailscale set --operator=$USER`)

get_state() { tailscale status --json 2>/dev/null | jq -r '.BackendState // empty'; }

state=$(get_state)
exit_node_ip=$(tailscale status | grep web | awk {'print $1'})

if [[ $BLOCK_BUTTON == 1 ]]; then
	case $state in
		Running) timeout 10 tailscale down >/dev/null 2>&1 ;;
		Stopped) timeout 10 tailscale up --advertise-tags=pc --exit-node=$exit_node_ip >/dev/null 2>&1 ;;
	esac
	state=$(get_state)
fi

case $state in
	Running)  text="TS: up";   color="#51f26c" ;;
	Stopped)  text="TS: down"; color="#f25151" ;;
	"")       text="TS: ?";    color="#f25151" ;;
	*)        text="TS: $state"; color="#f2ca51" ;;
esac

printf '%s\n%s\n%s\n' "$text" "$text" "$color"
