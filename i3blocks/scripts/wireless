#!/usr/bin/env bash

menu() {
	local toggle entries ssid pass
	if [[ $(nmcli radio wifi) == enabled ]]; then
		toggle="Desactivar WiFi"
		# SSID goes last so read keeps any ':' it contains (nmcli escapes them as '\:')
		entries=$(nmcli -t -f SIGNAL,SECURITY,SSID dev wifi list --rescan yes |
			awk -F: '$3 != "" && !seen[$0]++' | sort -t: -k1,1nr |
			while IFS=: read -r sig sec name; do
				printf '%s  (%s%%) %s\n' "${name//\\:/:}" "$sig" "${sec:+🔒}"
			done)
	else
		toggle="Activar WiFi"
	fi

	ssid=$(printf '%s\n%s\n' "$toggle" "$entries" | sed '/^$/d' | rofi -dmenu -i -p wifi) || return
	case $ssid in
		"Desactivar WiFi") nmcli radio wifi off; return ;;
		"Activar WiFi") nmcli radio wifi on; return ;;
	esac
	ssid=${ssid%%  (*}

	# Fails for unknown secured networks; ask for the password and retry
	nmcli dev wifi connect "$ssid" && return
	pass=$(rofi -dmenu -password -p "Clave de $ssid" </dev/null) || return
	nmcli dev wifi connect "$ssid" password "$pass"
}

# Detached so the bar is not blocked while the menu is open
case $BLOCK_BUTTON in
	1) setsid -f bash -c "$(declare -f menu); menu" >/dev/null 2>&1 ;;
	3) [[ $(nmcli radio wifi) == enabled ]] && nmcli radio wifi off || nmcli radio wifi on ;;
esac

iface=""
for dev in /sys/class/net/*; do
	[[ -d $dev/wireless ]] && { iface=${dev##*/}; break; }
done

# /proc/net/wireless only lists associated interfaces; column 4 is signal in dBm
level=$(awk -v i="$iface:" '$1 == i { sub(/\.$/, "", $4); print $4 }' /proc/net/wireless 2>/dev/null)

if [[ -z $iface || -z $level || $(cat "/sys/class/net/$iface/operstate") != up ]]; then
	echo "W: down"; echo "W: down"; echo "#f25151"
	exit 0
fi

# i3status nl80211 mapping: clamp to [-90, -20] dBm, then 100 - (-20 - dBm), i.e. 30%..100%
(( level < -90 )) && level=-90
(( level > -20 )) && level=-20
q=$(( 120 + level ))

printf 'W: %d%%\nW: %d%%\n#51f26c\n' "$q" "$q"
